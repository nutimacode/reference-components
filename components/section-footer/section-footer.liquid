{% comment %}
  section-footer component

  Accepts:
  - param1 {number} - Number to ouptput

  Usage:
  {%- render 'section-footer', param1: 0 -%}
{% endcomment %}

<style>
  /* Genel Footer Stili */
footer {
  background-color: #000;
  color: #fff;
  padding: 40px 45px;
  font-family: Arial, sans-serif;
  font-size: 14px;
  background-image: {{
    'big-logo.svg' | asset_url | prepend: 'url(' | append: ')'
  }};
  margin-top:40px;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  margin: 0 auto;
  border-bottom: 1px solid #333;
  padding-bottom: 40px;
}

.footer-column {
  width: 18%;
  margin-bottom: 20px;
}

.footer-column h6 {
  font-size: 16px;
  margin-bottom: 15px;
  text-transform: uppercase;
}

.footer-links {
  list-style: none;
  padding: 0;
}

.footer-links li {
  margin-bottom: 8px;
}

.footer-links a {
  color: #fff;
  text-decoration: none;
  transition: color 0.3s;
}

.footer-links a:hover {
  color: #aaa;
}

.newsletter-form {
  display: flex;
  flex-direction: column;
}

.newsletter-form input[type="email"] {
  padding: 10px;
  margin-bottom: 10px;
  border: 1px solid #333;
  background-color: #fff;
  color: black;
}

.newsletter-form input[type='checkbox'] {
  color: #fff;
  background-color: #444;
}

.newsletter-form button {
  padding: 10px;
  background-color: #fff;
  border: none;
  color: #444;
  cursor: pointer;
  width: 60%;
  transition: background-color 0.3s;
}

.newsletter-form button:hover {
  background-color: #555;
}

.newsletter-form label {
  font-size: 12px;
  margin-top: 10px;
}

.footer-social a {
  display: inline-block;
  margin-right: 10px;
}

.footer-social img {
  width: 24px;
  height: 24px;
}

/* Mobil Uygulama Logoları */
.app-logo a {
  margin-top: 30px;
}

.app-logo a {
  display: inline-block;
  margin-right: 10px;
}

.app-logo img {
  width: 120px;
  height: auto;
  transition: transform 0.3s;
}

.app-logo img:hover {
  transform: scale(1.05);
}

/* Telif Hakkı */
.footer-copyright {
  text-align: center;
  margin-top: 20px;
}

.footer-copyright p {
  font-size: 12px;
  color: white;
}

/* Responsive Tasarım */
@media (max-width: 768px) {
  .footer-column {
    width: 45%;
    margin-bottom: 20px;
  }

  .footer-container {
    flex-direction: column;
    align-items: center;
  }

  .newsletter-form {
    width: 100%;
  }

  .footer-social {
    text-align: center;
  }

  .app-logo {
    text-align: center;
    margin-top: 20px;
  }
}

@media (max-width: 480px) {
  .footer-column {
    width: 100%;
    margin-bottom: 20px;
  }

  .footer-container {
    padding: 20px;
  }

  .footer-column h6 {
    text-align: center;
  }

  .footer-links {
    text-align: center;
  }

  .footer-social,
  .app-logo {
    text-align: center;
    margin-top: 10px;
  }
}
.divider {
  margin: 30px 0;
  }
.footer-menus {
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.underline {
  text-decoration: underline;
}
.footer-social{
  display: flex;
  gap: 10px;
}
</style>
